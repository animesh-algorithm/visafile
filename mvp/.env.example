# LOCAL_STACK=true (default): SQLite + in-process worker — no Docker.
# LOCAL_STACK=false: Postgres + Redis + BullMQ (+ optional MinIO for PDFs).
LOCAL_STACK=true
SQLITE_PATH=./data/jobs.sqlite

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Used when LOCAL_STACK=false
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://ds160:ds160@127.0.0.1:5432/ds160

# PDF storage: local | s3 (MinIO uses s3)
PDF_STORAGE=local
PDF_LOCAL_DIR=./data/pdf-store
# MinIO / S3 (when PDF_STORAGE=s3)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=ds160-pdfs
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PREFIX=confirmations

# Worker / Puppeteer
# Headless is the default. If CEAC serves a Cloudflare check, the location page
# never loads and VisaFile cannot show the official CAPTCHA — use HEADLESS=false.
HEADLESS=true
DS160_VERBOSE=true
# Human browser-check handoff window. This is for CEAC's pre-form browser
# security page, not the official DS-160 CAPTCHA.
BROWSER_CHECK_TIMEOUT_MS=600000

WORKSPACE_ROOT=./workspaces

VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
# Optional shared secret for the VisaFile server-to-server automation API.
AUTOMATION_API_TOKEN=
