{
  "name": "ds160-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DS-160 MVP: form → queue → Puppeteer worker → live CAPTCHA/corrections → PDF",
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:api": "tsx watch api/server.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:migrate": "tsx scripts/migrate.ts",
    "generate:ceac-options": "node scripts/generate-ceac-options.mjs",
    "runner:terminal": "tsx runner/cli.ts",
    "build": "tsc -p tsconfig.json --noEmit && npm run build --prefix frontend"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.56.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "puppeteer": "^25.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
