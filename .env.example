# CEAC location code. HYD = India, Hyderabad.
DS160_LOCATION=HYD

# Headless by default. CAPTCHA image is saved to data/captcha.png.
# Set false to watch the browser.
HEADLESS=false

# Test-only security answer used during application setup.
DS160_SECURITY_ANSWER=TestAnswer

# Resume an existing application instead of starting a new one.
# Also pass --resume on the CLI, or set DS160_RESUME=true.
# DS160_RESUME=true
# DS160_APPLICATION_ID=AA00XXXXXX

# Slow: re-probe conditional Yes/No branches and rewrite field inventories.
# DS160_PROBE=true
# DS160_SAVE_INVENTORY=true

# Allow clicking "Sign and Submit Application" on SignCertify.
# Only enable with real applicant data in fixtures/.
# DS160_ALLOW_SUBMIT=true

# Timing / step logs (default on). Set false to drop [t+…] prefixes and sleep noise.
# DS160_VERBOSE=false

# Postback wait budget (ms). Radios usually no full-nav; selects may take ~3s+.
# DS160_POSTBACK_MS=2500
# DS160_SELECT_POSTBACK_MS=10000
# DS160_SETTLE_MS=150
